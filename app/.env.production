EXPO_PUBLIC_API_BASE_URL=https://api.freebus.co.il

# Aptabase analytics. Production only: .env.development deliberately has no key,
# so dev builds and forks of this repo send nothing.
EXPO_PUBLIC_APTABASE_APP_KEY=A-EU-5955052098

# Sentry crash reports (JavaScript errors only, scrubbed: see
# src/lib/crash-reports.ts). Production only, like Aptabase. Empty until the
# Sentry project exists; while it is empty the app reports nothing.
EXPO_PUBLIC_SENTRY_DSN=
