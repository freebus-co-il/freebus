EXPO_PUBLIC_API_BASE_URL=https://api.freebus.co.il

# Keys are not kept here. EXPO_PUBLIC_APTABASE_APP_KEY and EXPO_PUBLIC_SENTRY_DSN
# live in the EAS `production` environment (with the Maps key), which every
# production build and update loads. They are not secret, since they ship
# inside the app, but a file in this public repo would hand them to every
# fork's release build, which would then report into FreeBus's projects.
# `eas env:pull --environment production` writes them to .env.local if a local
# release build needs them.
