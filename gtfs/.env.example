PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

GTFS_URL=https://gtfs.mot.gov.il/gtfsfiles/israel-public-transportation.zip
# Default is <repo-root>/data (anchored on config.ts's own location, not
# process.cwd() — see README's "GTFS_DATA_DIR resolution"). Uncomment only to
# override; a relative value here is resolved against the repo root too, not
# against whatever directory the process happens to be launched from.
# GTFS_DATA_DIR=data
GTFS_KEEP_VERSIONS=2
GTFS_MAX_BAD_ROW_RATIO=0.01
GTFS_CRON=0 3 * * *
GTFS_TZ=Asia/Jerusalem

# Random delay (0..N ms) added to each cron tick.
GTFS_CRON_JITTER_MS=300000
# Idle timeout on the download: aborts a stream that goes silent this long.
# Re-armed on every chunk, so it never caps a slow-but-progressing transfer.
GTFS_STALL_TIMEOUT_MS=60000
# Ceiling on a whole import (a real one takes ~53s). Releases the
# single-flight lock so a wedged run can never block all future ones.
GTFS_RUN_TIMEOUT_MS=1800000
# Import at startup if the live database is older than this.
GTFS_STARTUP_MAX_AGE_MS=93600000
