{
  "name": "@freebus/gtfs",
  "version": "0.1.0",
  "private": true,
  "description": "Fetches and serves GTFS transit data",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=30000 \"src/**/*.test.ts\"",
    "test:live": "GTFS_LIVE_TEST=1 node --import tsx --test \"src/**/*.live.test.ts\""
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "csv-parse": "^7.0.2",
    "fastify": "^5.12.5",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/unzipper": "^0.10.11",
    "@types/yazl": "^3.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yazl": "^3.3.1"
  }
}
