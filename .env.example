# Copy to `.env` on the box, next to docker-compose.yml. Compose reads it
# automatically. `.env` is gitignored; this template is not.

# The hostname Caddy gets a certificate for, and the one freebus's
# EXPO_PUBLIC_API_BASE_URL points at.
API_DOMAIN=api.freebus.co.il

# Shared secret for POST /admin/reload, sent as `Authorization: Bearer <token>`.
# LEAVING THIS UNSET DOES NOT DISABLE AUTH -- the route then refuses every
# request, including yours. Generate one with:
#   openssl rand -hex 32
TRANSIT_ADMIN_TOKEN=

# Address search backend -- the whole switch:
#   google  Google Places API. Finds businesses and addresses OSM lacks.
#           Metered: see api/src/geocode/google.ts for the cost model.
#   photon  Self-hosted Photon over OpenStreetMap. Free, misses most businesses.
# After changing it, run ./deploy.sh: it builds and starts Photon, or removes
# its container and image, to match.
GEOCODER=google

# Only read when GEOCODER=google, and never sent to clients. In Google Cloud,
# restrict the key to this box's IP (application restriction) and to
# "Places API (New)" + "Geocoding API" (API restriction), and set a daily
# quota on both -- the limit below is only a per-process backstop.
GOOGLE_MAPS_API_KEY=
# Billable Google calls per UTC day before address search returns nothing
# until midnight. 0 = no ceiling.
# GOOGLE_MAPS_DAILY_REQUEST_LIMIT=3000

# (COMPOSE_PROFILES used to gate Photon behind a `photon` profile. Photon now
# runs in both modes -- it answers reverse geocoding whichever GEOCODER is set
# -- so nothing declares a profile any more and deploy.sh clears the variable.)

# Where Photon's prebuilt index is fetched from on first boot. The default in
# docker-compose.yml is the `photon-index-latest` GitHub release, which is
# what production should use -- override here only to test a new index
# before publishing it.
# PHOTON_PREBUILT_URL=https://github.com/freebus-co-il/freebus/releases/download/photon-index-latest/photon-index-il-ps.tar.zst

# Per-client-IP requests/minute GET /plan (the RAPTOR search endpoint) will
# answer before 429ing, separate from the global 300/min limit. Default 60 is
# sized for carrier-grade NAT -- many riders can share one IP -- and for the
# app's own once-a-minute poll of an open results screen. Raise it if real
# riders are seeing 429s; see api/src/config.ts for the full reasoning.
# PLAN_RATE_LIMIT_PER_MINUTE=60

# Same per-client-IP idea as PLAN_RATE_LIMIT_PER_MINUTE, for the other three
# RAPTOR-backed endpoints -- each serving a rider mid-journey, so their
# defaults are generous. Raise, don't remove, if real riders see 429s; see
# `routeRateLimits` in api/src/config.ts for the full reasoning.
# JOURNEY_CHECK_RATE_LIMIT_PER_MINUTE=120
# PLAN_ONBOARD_RATE_LIMIT_PER_MINUTE=60
# SEGMENTS_RATE_LIMIT_PER_MINUTE=120
