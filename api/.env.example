PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Jerusalem

# Shared secret required by POST /admin/reload, presented as
# `Authorization: Bearer <token>`. LEAVING THIS UNSET DOES NOT DISABLE AUTH:
# the route then refuses every request. Generate one with, e.g.,
#   openssl rand -hex 32
TRANSIT_ADMIN_TOKEN=

# Defaults are anchored on the repo root, not the working directory.
# GTFS_DATA_DIR=data
# TRANSIT_CACHE_DIR=cache

TRANSIT_RELOAD_POLL_MS=60000

VALHALLA_URL=http://localhost:8002
VALHALLA_TIMEOUT_MS=5000
VALHALLA_BATCH_SIZE=50
# Address search: `photon` (needs the container) or `google` (needs the key).
GEOCODER=photon
PHOTON_URL=http://localhost:2322
PHOTON_TIMEOUT_MS=5000
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=3000
GOOGLE_MAPS_DAILY_REQUEST_LIMIT=3000

WALK_MAX_METERS=1000
WALK_SPEED_MPS=1.33
TRANSFER_MIN_SECONDS=60
SAME_STATION_TRANSFER_SECONDS=180
