{
  "name": "@freebus/api",
  "version": "0.2.0",
  "private": true,
  "description": "REST API over the GTFS database for transit route planning",
  "type": "module",
  "main": "dist/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "bake:rail": "tsx src/rail/bakeMain.ts",
    "test": "node --import tsx --test --test-timeout=30000 \"src/**/*.test.ts\"",
    "test:live": "TRANSIT_LIVE_TEST=1 node --import tsx --test \"src/**/*.live.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
